#!/usr/bin/env sh
set -eu

# Git LFS pre-push
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
git lfs pre-push "$@"

# Regenerate site manifests
repo_root="$(git rev-parse --show-toplevel)"
source_manifest="assets/source-documents-catholic.json"
infographics_manifest="assets/infographics-manifest.json"

echo "[pre-push] Regenerating site manifests..."
python "$repo_root/scripts/generate_source_manifest.py"

changed=0

for manifest_path in "$source_manifest" "$infographics_manifest"; do
  if ! git diff --quiet -- "$manifest_path" || ! git diff --cached --quiet -- "$manifest_path"; then
    echo "[pre-push] Manifest changed; staging $manifest_path"
    git add "$manifest_path"
    changed=1
  fi
done

# Stop the push rather than committing behind its back.
#
# Git works out which commits to send before it runs this hook, so a commit
# created here is NOT part of the push in progress — it sits locally and goes
# out with whatever you push next. The hook used to do exactly that and print
# "Push will continue", which meant the regenerated manifests silently shipped
# one push late. Failing here costs one extra command and keeps the deployed
# manifests honest.
if [ "$changed" -eq 1 ]; then
  echo
  echo "[pre-push] The generated manifests are out of date and have been staged."
  echo "[pre-push] Commit them and push again:"
  echo
  echo "    git commit -m \"chore: update generated manifests\""
  echo "    git push"
  echo
  exit 1
fi

echo "[pre-push] Manifests are up to date."
