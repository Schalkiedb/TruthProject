#!/usr/bin/env sh
set -eu

# Git LFS pre-push
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'pre-push' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
git lfs pre-push "$@"

# Regenerate site manifests
repo_root="$(git rev-parse --show-toplevel)"
source_manifest="assets/source-documents-catholic.json"
infographics_manifest="assets/infographics-manifest.json"

echo "[pre-push] Regenerating site manifests..."
python "$repo_root/scripts/generate_source_manifest.py"

changed=0

for manifest_path in "$source_manifest" "$infographics_manifest"; do
  if ! git diff --quiet -- "$manifest_path" || ! git diff --cached --quiet -- "$manifest_path"; then
    echo "[pre-push] Manifest changed; staging $manifest_path"
    git add "$manifest_path"
    changed=1
  fi
done

if [ "$changed" -eq 1 ]; then
  if ! git diff --cached --quiet -- "$source_manifest" "$infographics_manifest"; then
    echo "[pre-push] Creating auto-commit for updated manifests..."
    if git commit -m "chore: update generated manifests" -- "$source_manifest" "$infographics_manifest"; then
      echo "[pre-push] Auto-commit created. Push will continue."
    else
      echo "[pre-push] Failed to commit manifests."
      exit 1
    fi
  fi
fi

echo "[pre-push] Manifests are up to date."
